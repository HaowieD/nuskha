# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=change-me-to-a-long-random-string
SITE_URL=https://nuskha.ge

# First administrator, created on startup if the e-mail does not exist yet.
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-too

# Google sign-in (optional). Authorized redirect URI: https://<your-domain>/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail (optional). When SMTP_HOST and SMTP_FROM are set, new accounts must confirm their e-mail
# and "Forgot password" works. Port 587 = STARTTLS; for port 465 set SMTP_IMPLICIT_TLS=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_IMPLICIT_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nuskha.ge
