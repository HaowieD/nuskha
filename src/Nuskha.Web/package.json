{
  "name": "nuskha-web",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i Styles/app.css -o wwwroot/css/app.css --minify",
    "css:watch": "tailwindcss -i Styles/app.css -o wwwroot/css/app.css --watch",
    "htmx": "node -e \"require('fs').mkdirSync('wwwroot/lib',{recursive:true});require('fs').copyFileSync('node_modules/htmx.org/dist/htmx.min.js','wwwroot/lib/htmx.min.js')\"",
    "build": "npm run htmx && npm run css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "htmx.org": "^2.0.4"
  }
}
