<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Nuskha.Web</RootNamespace>
    <UserSecretsId>nuskha-web</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.*" />
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="Markdig" Version="0.*" />
    <ProjectReference Include="..\Nuskha.Infrastructure\Nuskha.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Web SDK already globs *.json as Content; Update (not Include) avoids a duplicate-item error. -->
    <Content Update="Localization\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
