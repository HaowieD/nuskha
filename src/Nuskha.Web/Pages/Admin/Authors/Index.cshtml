@page "/admin/authors"
@model Nuskha.Web.Pages.Admin.Authors.IndexModel
@{ ViewData["Title"] = T["admin.authors"]; }
<h1 class="mb-4 text-2xl font-bold">@T["admin.authors"] <span class="text-soft">(@Model.Total)</span></h1>

<form method="get" role="search" class="card mb-4 flex flex-wrap items-end gap-3">
    <div class="min-w-48 flex-1">
        <label class="label" for="q">@T["authors.search"]</label>
        <input id="q" name="q" type="search" value="@Model.Q" class="input" />
    </div>
    <button class="btn btn-primary" type="submit">@T["common.search"]</button>
</form>

<ul class="space-y-2">
    @foreach (var a in Model.Rows)
    {
        <li class="card">
            <details>
                <summary class="flex cursor-pointer flex-wrap items-center justify-between gap-2">
                    <span class="font-medium">@a.Name @if (!string.IsNullOrWhiteSpace(a.NameEn)) { <span class="text-soft">· @a.NameEn</span> }</span>
                    <span class="chip">@T.Format("authors.books", a.BookCount)</span>
                </summary>
                <form method="post" asp-page-handler="Save" class="mt-3 space-y-3">
                    <input type="hidden" name="id" value="@a.Id" />
                    <input type="hidden" name="q" value="@Model.Q" />
                    <input type="hidden" name="p" value="@Model.PageNo" />
                    <div class="grid gap-3 sm:grid-cols-2">
                        <div>
                            <label class="label" for="@("name-" + a.Id)">@T["admin.author.name"]</label>
                            <input id="@("name-" + a.Id)" name="name" value="@a.Name" maxlength="200" required class="input" />
                        </div>
                        <div>
                            <label class="label" for="@("nameen-" + a.Id)">@T["admin.author.nameen"]</label>
                            <input id="@("nameen-" + a.Id)" name="nameEn" value="@a.NameEn" maxlength="200" class="input" />
                        </div>
                    </div>
                    <div>
                        <label class="label" for="@("bio-" + a.Id)">@T["settings.bio"]</label>
                        <textarea id="@("bio-" + a.Id)" name="bio" rows="3" maxlength="4000" class="input">@a.Bio</textarea>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button class="btn btn-primary btn-sm" type="submit">@T["common.save"]</button>
                        <a class="btn btn-sm" href="/authors/@a.Slug">@T["admin.view"]</a>
                    </div>
                </form>
                @if (a.BookCount == 0)
                {
                    <form method="post" asp-page-handler="Delete" class="mt-2">
                        <input type="hidden" name="id" value="@a.Id" />
                        <input type="hidden" name="q" value="@Model.Q" />
                        <input type="hidden" name="p" value="@Model.PageNo" />
                        <button class="btn btn-sm btn-danger" type="submit" data-confirm="@T["common.confirm"]">@T["common.delete"]</button>
                    </form>
                }
            </details>
        </li>
    }
</ul>
<partial name="_Pager" model="new PagerModel(Model.PageNo, Model.TotalPages)" />
