@page "/admin/import"
@using Nuskha.Infrastructure.Import
@model Nuskha.Web.Pages.Admin.ImportModel
@{ ViewData["Title"] = T["admin.import"]; }
<div class="space-y-6">
    <h1 class="text-2xl font-bold">@T["admin.import"]</h1>

    <section aria-labelledby="sources-h">
        <h2 id="sources-h" class="mb-2 text-lg font-bold">@T["admin.import.sources"]</h2>
        <ul class="space-y-2">
            @foreach (var s in Model.Sources)
            {
                <li class="card flex flex-wrap items-start justify-between gap-2">
                    <div class="min-w-0 flex-1">
                        <p class="font-medium">@s.DisplayName <code class="hint">@s.Id</code></p>
                        <p class="hint">@s.Notes</p>
                    </div>
                    <span class="@("chip " + (s.Enabled ? "" : "opacity-60"))">@(s.Enabled ? T["admin.enabled"] : T["admin.disabled"])</span>
                </li>
            }
        </ul>
        <p class="hint mt-2">@T["admin.import.legal"]</p>
    </section>

    <section aria-labelledby="run-h">
        <h2 id="run-h" class="mb-2 text-lg font-bold">@T["admin.import.run"]</h2>
        <form method="post" class="card grid gap-3 sm:grid-cols-[12rem_1fr_8rem_auto]">
            @if (Model.Errors.ContainsKey("Form")) { <p class="field-error sm:col-span-4" role="alert">@T[Model.Errors["Form"]]</p> }
            <div>
                <label class="label" for="Source">@T["admin.source"]</label>
                <select id="Source" name="Source" class="input" required>
                    @foreach (var s in Model.Sources.Where(s => s.Enabled))
                    {
                        <option value="@s.Id" selected="@(s.Id == Model.Source)">@s.DisplayName</option>
                    }
                </select>
                <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Source")' />
            </div>
            <div>
                <label class="label" for="Query">@T["admin.import.query"]</label>
                <input id="Query" name="Query" value="@Model.Query" class="input" maxlength="300" />
                <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Query")' />
            </div>
            <div>
                <label class="label" for="Limit">@T["admin.import.limit"]</label>
                <input id="Limit" name="Limit" type="number" min="1" max="5000" value="@Model.Limit" class="input" />
                <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Limit")' />
            </div>
            <div class="flex items-end"><button class="btn btn-primary w-full" type="submit">@T["admin.import.start"]</button></div>
        </form>
    </section>

    @if (Model.Sources.OfType<SitemapJsonLdSource>().Any())
    {
        <section aria-labelledby="check-h">
            <h2 id="check-h" class="mb-2 text-lg font-bold">@T["admin.import.check"]</h2>
            <form method="post" asp-page-handler="Check" class="card grid gap-3 sm:grid-cols-[12rem_1fr_auto]">
                <div>
                    <label class="label" for="CheckSource">@T["admin.source"]</label>
                    <select id="CheckSource" name="CheckSource" class="input" required>
                        @foreach (var s in Model.Sources.OfType<SitemapJsonLdSource>())
                        {
                            <option value="@s.Id" selected="@(s.Id == Model.CheckSource)">@s.DisplayName</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="label" for="CheckUrl">@T["admin.import.check.url"]</label>
                    <input id="CheckUrl" name="CheckUrl" type="url" value="@Model.CheckUrl" class="input" maxlength="500" required />
                    <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "CheckUrl")' />
                </div>
                <div class="flex items-end"><button class="btn w-full" type="submit">@T["admin.import.check.go"]</button></div>
                <p class="hint sm:col-span-3">@T["admin.import.check.hint"]</p>
            </form>

            @if (Model.Check is { } c)
            {
                <div class="card mt-3 space-y-1" role="status">
                    @if (c.Status is { } code) { <p class="text-sm">@T["admin.import.check.status"]: <code>@code</code></p> }
                    @if (c.ErrorKey is not null)
                    {
                        <p class="text-red-700" role="alert">@T[c.ErrorKey]</p>
                    }
                    else
                    {
                        <p class="text-sm">@T["admin.import.check.types"]: <code>@(c.JsonLdTypes.Count == 0 ? T["admin.import.check.none"] : string.Join(", ", c.JsonLdTypes))</code></p>
                        @if (c.Book is { } b)
                        {
                            <p class="font-medium">@T["admin.import.check.found"]</p>
                            <ul class="text-sm">
                                <li><strong>@T["admin.import.check.title"]:</strong> @b.Title</li>
                                <li><strong>@T["admin.import.check.authors"]:</strong> @(b.Authors.Count == 0 ? "—" : string.Join(", ", b.Authors))</li>
                                <li><strong>ISBN:</strong> @(b.Isbn ?? "—")</li>
                                <li><strong>@T["book.publisher"]:</strong> @(b.Publisher ?? "—")</li>
                                <li><strong>@T["book.year"]:</strong> @(b.Year?.ToString() ?? "—")</li>
                                <li><strong>@T["book.pages"]:</strong> @(b.Pages?.ToString() ?? "—")</li>
                            </ul>
                        }
                        else
                        {
                            <p>@T["admin.import.check.nobook"]</p>
                        }
                    }
                </div>
            }
        </section>
    }

    <section aria-labelledby="runs-h">
        <h2 id="runs-h" class="mb-2 text-lg font-bold">@T["admin.import.runs"]</h2>
        <div hx-get="/admin/import?handler=Runs" hx-trigger="every 5s" hx-swap="innerHTML">
            <partial name="_ImportRuns" model="Model.Runs" />
        </div>
    </section>
</div>
