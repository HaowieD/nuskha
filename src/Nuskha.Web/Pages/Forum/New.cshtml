@page "/forum/new"
@model Nuskha.Web.Pages.Forum.NewModel
@{ ViewData["Title"] = T["forum.new"]; }
<div class="mx-auto max-w-2xl space-y-4">
    <h1 class="text-2xl font-bold">@T["forum.new"]</h1>
    <form method="post" class="card space-y-3">
        <div>
            <label class="label" for="Category">@T["forum.category"]</label>
            <select id="Category" name="Category" class="input" required>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Slug" selected="@(c.Slug == Model.Category)">@T.Pick(c.Name, c.NameEn)</option>
                }
            </select>
            <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Category")' />
        </div>
        <div>
            <label class="label" for="Title">@T["forum.f.title"]</label>
            <input id="Title" name="Title" value="@Model.Title" maxlength="200" required class="input" />
            <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Title")' />
        </div>
        <div>
            <label class="label" for="Body">@T["forum.f.body"]</label>
            <textarea id="Body" name="Body" rows="8" maxlength="10000" required class="input">@Model.Body</textarea>
            <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Body")' />
        </div>
        <button class="btn btn-primary" type="submit">@T["forum.f.create"]</button>
    </form>
</div>
