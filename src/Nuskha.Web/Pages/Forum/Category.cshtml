@page "/forum/{slug}"
@model Nuskha.Web.Pages.Forum.CategoryModel
@{
    var name = T.Pick(Model.Category.Name, Model.Category.NameEn);
    ViewData["Title"] = name;
    ViewData["Description"] = T.Pick(Model.Category.Description ?? "", Model.Category.DescriptionEn);
}
<nav class="mb-2 text-sm" aria-label="breadcrumb"><a class="link" href="/forum">@T["forum.title"]</a> / <span>@name</span></nav>
<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold">@name</h1>
    @if (User.Identity!.IsAuthenticated) { <a class="btn btn-primary" href="/forum/new?category=@Model.Category.Slug">@T["forum.new"]</a> }
</div>

@if (Model.Threads.Count == 0)
{
    <p class="card text-soft">@T["forum.empty"]</p>
}
else
{
    <ul class="space-y-2">
        @foreach (var t in Model.Threads)
        {
            <li class="card flex flex-wrap items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <a class="font-medium no-underline hover:text-accent" href="/forum/thread/@t.Slug">@t.Title</a>
                    @if (t.IsPinned) { <span class="chip ml-1">@T["forum.pinned"]</span> }
                    @if (t.IsLocked) { <span class="chip ml-1">@T["forum.locked"]</span> }
                    <p class="hint">@t.AuthorName (<a class="link" href="/user/@t.AuthorUserName">@@@t.AuthorUserName</a>)</p>
                </div>
                <div class="text-right text-sm">
                    <p>@T.Format("forum.posts", t.PostCount)</p>
                    <p class="hint">@T.TimeAgo(t.LastPostAt)</p>
                </div>
            </li>
        }
    </ul>
    <partial name="_Pager" model="new PagerModel(Model.PageNo, Model.TotalPages)" />
}
