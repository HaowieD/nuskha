@model ActivityItem
@{
    var title = T.IsEnglish && !string.IsNullOrWhiteSpace(Model.BookTitleEn) ? Model.BookTitleEn : Model.BookTitle;
    var verb = Model.Type switch
    {
        ActivityType.AddedToList => T["activity.added"],
        ActivityType.StatusChanged => T["activity.status"],
        ActivityType.Rated => T.Format("activity.rated", Model.Data ?? "?"),
        ActivityType.Completed => T["activity.completed"],
        ActivityType.ThreadCreated => T["activity.thread"],
        _ => ""
    };
    var statusLabel = (Model.Type is ActivityType.AddedToList or ActivityType.StatusChanged) && Model.Data is not null
        ? T["status." + Model.Data] : null;
    var dom = "comments-" + (int)TargetType.Activity + "-" + Model.Id;
}
<article class="card" id="@("activity-" + Model.Id)">
    <div class="flex items-start gap-3">
        <partial name="_Avatar" model='new AvatarModel(Model.AvatarPath, Model.DisplayName, "md")' />
        <div class="min-w-0 flex-1">
            <p class="text-sm">
                <a class="font-semibold no-underline hover:text-accent" href="/user/@Model.UserName">@Model.DisplayName</a>
                <span class="text-soft">@verb</span>
                @if (Model.BookSlug is not null)
                {
                    <a class="link font-medium" href="/books/@Model.BookSlug">@title</a>
                }
                else if (Model.ThreadSlug is not null)
                {
                    <a class="link font-medium" href="/forum/thread/@Model.ThreadSlug">@Model.ThreadTitle</a>
                }
                @if (statusLabel is not null) { <span class="chip ml-1">@statusLabel</span> }
                @if (Model.Type == ActivityType.Completed && !string.IsNullOrEmpty(Model.Data)) { <span class="chip ml-1">★ @Model.Data/10</span> }
            </p>
            <p class="hint"><time datetime="@Model.CreatedAt.ToString("o")">@T.TimeAgo(Model.CreatedAt)</time></p>
            <div class="mt-2 flex items-center gap-2">
                <partial name="_LikeButton" model="new LikeButtonModel(TargetType.Activity, Model.Id, Model.LikeCount, Model.Liked)" />
                <button type="button" class="btn btn-sm" hx-get="/social/comments?type=@((int)TargetType.Activity)&id=@Model.Id"
                        hx-target="#@dom" hx-swap="outerHTML">
                    @T["comments.title"] (@Model.CommentCount)
                </button>
            </div>
            <div id="@dom" class="mt-3"></div>
        </div>
    </div>
</article>
