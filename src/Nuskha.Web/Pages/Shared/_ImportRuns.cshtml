@model List<ImportRun>
@if (Model.Count == 0)
{
    <p class="card text-soft">@T["admin.import.none"]</p>
}
else
{
    <div class="overflow-x-auto">
        <table class="table-simple">
            <thead>
                <tr>
                    <th scope="col">@T["admin.source"]</th>
                    <th scope="col">@T["admin.import.query"]</th>
                    <th scope="col">@T["admin.created"]</th>
                    <th scope="col">@T["list.status"]</th>
                    <th scope="col">@T["admin.import.added"]</th>
                    <th scope="col">@T["admin.import.updated"]</th>
                    <th scope="col">@T["admin.import.skipped"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Source</td>
                        <td>@(r.Query ?? "—")</td>
                        <td class="whitespace-nowrap">@r.StartedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (r.Error is not null) { <span class="text-red-700">@r.Error</span> }
                            else if (r.FinishedAt is null) { <span class="chip">@T["admin.import.running"]</span> }
                            else { <span class="chip">@T["admin.import.done"]</span> }
                        </td>
                        <td>@r.Added</td>
                        <td>@r.Updated</td>
                        <td>@r.Skipped</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
