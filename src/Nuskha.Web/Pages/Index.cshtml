@page "/"
@model Nuskha.Web.Pages.IndexModel
@{ ViewData["Title"] = T["home.title"]; }

@if (!User.Identity!.IsAuthenticated)
{
    <section class="mb-8 rounded-2xl border border-line bg-paper2 p-6 sm:p-10">
        <h1 class="max-w-2xl text-3xl font-bold leading-tight sm:text-4xl">@T["home.hero.title"]</h1>
        <p class="mt-3 max-w-xl text-soft">@T["home.hero.text"]</p>
        <div class="mt-5 flex flex-wrap gap-3">
            <a class="btn btn-primary" href="/account/register">@T["auth.register"]</a>
            <a class="btn" href="/books">@T["home.browse"]</a>
        </div>
    </section>
}

<div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <section aria-labelledby="feed-h">
        <div class="mb-3 flex items-center justify-between">
            <h2 id="feed-h" class="text-xl font-bold">@T["home.activity"]</h2>
            <nav class="flex gap-2 text-sm" aria-label="@T["home.activity"]">
                <a class="@("btn btn-sm " + (Model.Following ? "" : "border-accent text-accent"))" href="/" @(Model.Following ? "" : "aria-current=page")>@T["home.global"]</a>
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="@("btn btn-sm " + (Model.Following ? "border-accent text-accent" : ""))" href="/?scope=following" @(Model.Following ? "aria-current=page" : "")>@T["home.following"]</a>
                }
            </nav>
        </div>
        <div class="space-y-3">
            <partial name="_FeedList" model="Model.Feed" />
            @if (Model.Feed.Items.Count == 0)
            {
                <p class="card text-soft">@(Model.Following ? T["home.following.empty"] : T["home.empty"])</p>
            }
        </div>
    </section>

    <aside class="space-y-8" aria-label="@T["home.popular"]">
        <section>
            <h2 class="mb-3 text-lg font-bold">@T["home.popular"]</h2>
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-2">
                @foreach (var b in Model.Popular) { <partial name="_BookCard" model="b" /> }
            </div>
        </section>
        <section>
            <h2 class="mb-3 text-lg font-bold">@T["home.newest"]</h2>
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-2">
                @foreach (var b in Model.Newest) { <partial name="_BookCard" model="b" /> }
            </div>
        </section>
    </aside>
</div>
