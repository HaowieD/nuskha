@page "/account/forgot-password"
@model Nuskha.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = T["auth.forgot.title"]; }
<div class="mx-auto max-w-md space-y-4">
    <h1 class="text-2xl font-bold">@T["auth.forgot.title"]</h1>
    @if (!Model.EmailEnabled)
    {
        <p class="card" role="status">@T["auth.mail.unavailable"]</p>
    }
    else if (Model.Sent)
    {
        <p class="card" role="status">@T["auth.forgot.sent"]</p>
    }
    else
    {
        <p class="text-soft">@T["auth.forgot.intro"]</p>
        <form method="post" class="card space-y-3">
            <div>
                <label class="label" for="Email">@T["auth.email"]</label>
                <input id="Email" name="Email" type="email" value="@Model.Email" class="input" autocomplete="email" required />
                <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Email")' />
            </div>
            <button class="btn btn-primary w-full" type="submit">@T["auth.forgot.send"]</button>
        </form>
    }
    <p class="text-center text-sm"><a class="link" asp-page="/Account/Login">@T["auth.login"]</a></p>
</div>
