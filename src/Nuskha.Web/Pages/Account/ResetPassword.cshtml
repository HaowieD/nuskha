@page "/account/reset-password"
@model Nuskha.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = T["auth.reset.title"]; }
<div class="mx-auto max-w-md space-y-4">
    <h1 class="text-2xl font-bold">@T["auth.reset.title"]</h1>
    @if (Model.Done)
    {
        <p class="card" role="status">@T["auth.reset.done"]</p>
        <a class="btn btn-primary" asp-page="/Account/Login">@T["auth.login"]</a>
    }
    else if (Model.Invalid)
    {
        <p class="card border-red-700 text-red-700" role="alert">@T["auth.link.invalid"]</p>
        <a class="link" asp-page="/Account/ForgotPassword">@T["auth.forgot.title"]</a>
    }
    else
    {
        <form method="post" class="card space-y-3">
            <input type="hidden" name="UserId" value="@Model.UserId" />
            <input type="hidden" name="Code" value="@Model.Code" />
            <div>
                <label class="label" for="Password">@T["auth.password"]</label>
                <input id="Password" name="Password" type="password" class="input" autocomplete="new-password" required />
                <p class="text-xs text-soft">@T["auth.password.hint"]</p>
                <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Password")' />
            </div>
            <div>
                <label class="label" for="ConfirmPassword">@T["auth.password.confirm"]</label>
                <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="input" autocomplete="new-password" required />
                <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "ConfirmPassword")' />
            </div>
            <button class="btn btn-primary w-full" type="submit">@T["auth.reset.save"]</button>
        </form>
    }
</div>
