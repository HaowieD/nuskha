@page "/books/submit"
@model Nuskha.Web.Pages.Books.SubmitModel
@{ ViewData["Title"] = T["submit.title"]; }
<div class="mx-auto max-w-2xl space-y-4">
    <h1 class="text-2xl font-bold">@T["submit.title"]</h1>

    @if (Model.Done)
    {
        <p class="card" role="status">@T["submit.thanks"]</p>
        <a class="btn" href="/books">@T["books.title"]</a>
    }
    else
    {
        <p class="hint">@T["submit.help"]</p>
        <form method="post" enctype="multipart/form-data" class="card space-y-3">
            @if (Model.Errors.ContainsKey("Form"))
            {
                <p class="field-error" role="alert">
                    @T[Model.Errors["Form"]]
                    @if (Model.DuplicateSlug is not null) { <a class="link" href="/books/@Model.DuplicateSlug">@T["submit.open"]</a> }
                </p>
            }
            <div>
                <label class="label" for="Title">@T["submit.f.title"]</label>
                <input id="Title" name="Title" value="@Model.Title" class="input" maxlength="300" required />
                <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Title")' />
            </div>
            <div>
                <label class="label" for="TitleEn">@T["submit.f.titleen"]</label>
                <input id="TitleEn" name="TitleEn" value="@Model.TitleEn" class="input" maxlength="300" />
            </div>
            <div>
                <label class="label" for="Authors">@T["submit.f.authors"]</label>
                <textarea id="Authors" name="Authors" rows="2" class="input" required aria-describedby="authors-hint">@Model.Authors</textarea>
                <p id="authors-hint" class="hint">@T["submit.f.authors.hint"]</p>
                <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Authors")' />
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
                <div>
                    <label class="label" for="Isbn">ISBN</label>
                    <input id="Isbn" name="Isbn" value="@Model.Isbn" class="input" maxlength="20" inputmode="numeric" />
                    <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Isbn")' />
                </div>
                <div>
                    <label class="label" for="Publisher">@T["book.publisher"]</label>
                    <input id="Publisher" name="Publisher" value="@Model.Publisher" class="input" maxlength="200" />
                </div>
                <div>
                    <label class="label" for="PublishYear">@T["book.year"]</label>
                    <input id="PublishYear" name="PublishYear" type="number" value="@Model.PublishYear" class="input" min="1000" max="2100" />
                    <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "PublishYear")' />
                </div>
                <div>
                    <label class="label" for="PageCount">@T["book.pages"]</label>
                    <input id="PageCount" name="PageCount" type="number" value="@Model.PageCount" class="input" min="1" max="20000" />
                    <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "PageCount")' />
                </div>
            </div>
            <div>
                <label class="label" for="Description">@T["book.description"]</label>
                <textarea id="Description" name="Description" rows="5" maxlength="4000" class="input">@Model.Description</textarea>
                <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Description")' />
            </div>
            <div>
                <label class="label" for="Cover">@T["submit.f.cover"]</label>
                <input id="Cover" name="Cover" type="file" accept="image/jpeg,image/png,image/webp" class="input" />
                <p class="hint">@T["submit.f.cover.hint"]</p>
                <partial name="_FieldError" model='new FieldErrorModel(Model.Errors, "Cover")' />
            </div>
            <button class="btn btn-primary" type="submit">@T["submit.send"]</button>
        </form>
    }
</div>
