@page "/books/submit"
@model Nuskha.Web.Pages.Books.SubmitModel
@{ ViewData["Title"] = T["submit.title"]; }
<div class="mx-auto max-w-2xl space-y-4">
    <h1 class="text-2xl font-bold">@T["submit.title"]</h1>

    @if (Model.Done)
    {
        <p class="card" role="status">@T["submit.thanks"]</p>
        <div class="flex gap-2">
            <a class="btn btn-primary" href="/books/mine">@T["submit.mine"]</a>
            <a class="btn" href="/books">@T["books.title"]</a>
        </div>
    }
    else
    {
        <p class="hint">@T["submit.help"]</p>
        <details class="card text-sm">
            <summary class="cursor-pointer font-medium">@T["submit.standards"]</summary>
            <ul class="mt-2 list-disc space-y-1 pl-5">
                <li>@T["submit.standards.1"]</li>
                <li>@T["submit.standards.2"]</li>
                <li>@T["submit.standards.3"]</li>
                <li>@T["submit.standards.4"]</li>
                <li>@T["submit.standards.5"]</li>
            </ul>
        </details>
        @if (Model.ReviewNote is not null)
        {
            <div class="card border-red-700" role="status">
                <p class="font-medium text-red-700">@T["submit.rejected"]</p>
                <div class="md mt-1">@Md.Render(Model.ReviewNote)</div>
            </div>
        }
        <form method="post" enctype="multipart/form-data" class="card space-y-3">
            @if (Model.EditId is Guid editId) { <input type="hidden" name="EditId" value="@editId" /> }
            @if (Model.Errors.ContainsKey("Form"))
            {
                <p class="field-error" role="alert">
                    @T[Model.Errors["Form"]]
                    @if (Model.DuplicateSlug is not null) { <a class="link" href="/books/@Model.DuplicateSlug">@T["submit.open"]</a> }
                </p>
            }
            <partial name="_BookForm" model="Model.View" />
            <button class="btn btn-primary" type="submit">@(Model.EditId is null ? T["submit.send"] : T["submit.resend"])</button>
        </form>
    }
</div>
